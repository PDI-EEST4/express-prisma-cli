model <%= resourceName %> {
  id String @id @default(cuid()) 
  <% fields.forEach(function({ name, type, references, unique }) { %> 
  <% if (type !== "fk") { %><%= name %> <%= type %> <%= unique ? "@unique" : "" %><% } else { %><%= name %> String
  <%= name.replace("_id", "") %> <%= references %> @relation(fields: [<%= name %>], references: [id])<% } %> <% }); %>
  <% if (timestamps) { %>
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  <% } %>
  @@map("<%= tableName %>")
}
